<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#202020"
    android:padding="24dp">

    <animation.library.ShimmerButton
        android:id="@+id/shimmerButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shimmer Button"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:background="#3949AB"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        tools:ignore="HardcodedText" />

    <animation.library.TitanicButton
        android:id="@+id/titanicButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Titanic Button"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:background="#00838F"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        tools:ignore="HardcodedText" />

    <animation.library.ShimmerTextView
        android:id="@+id/shimmerTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Shimmer Text"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        tools:ignore="HardcodedText" />

    <animation.library.TitanicTextView
        android:id="@+id/titanicTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Titanic Text"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        tools:ignore="HardcodedText" />

</LinearLayout>
